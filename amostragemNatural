% =========================================================================
% SigmaDSP Inc. - Problema 01: Amostragem Natural e Reconstrução de Sinal
% Ferramenta: MATLAB / Octave
% =========================================================================
clear; clc; close all;

%% 1. PARÂMETROS DA SIMULAÇÃO (TEMPO CONTÍNUO EMULADO)
Fs_sim = 100e3;              % Frequência de amostragem da simulação (100 kHz)
dt = 1 / Fs_sim;             % Passo de tempo
T_total = 0.1;               % Janela temporal ampla (0.1s para alta resolução em F)
t = 0:dt:T_total-dt;         % Vetor de tempo contínuo
N = length(t);               % Número total de pontos

%% 2. SINAL ANALÓGICO DE ENTRADA g(t)
f1 = 100;                    % Senoide útil principal (100 Hz)
f2 = 800;                    % Segunda senoide (componente de alta frequência / interferência)
A1 = 1.0;                    % Amplitude da senoide 1
A2 = 0.5;                    % Amplitude da senoide 2

% Sinal analógico g(t) com duas componentes senoidais
g_t = A1*cos(2*pi*f1*t) + A2*cos(2*pi*f2*t);

%% 3. SELEÇÃO DA FREQUÊNCIA DE AMOSTRAGEM f_s
% Para testar com e sem aliasing, altere a variável abaixo:
%   - Modo 1 (Sem Aliasing): Fs_amostragem = 2000 Hz (> 2 * f2)
%   - Modo 2 (Com Aliasing): Fs_amostragem = 1200 Hz (< 2 * f2)

Fs_amostragem = 2000;         % Ajuste esta taxa para observar o aliasing!
Ts = 1 / Fs_amostragem;       % Período de amostragem
d = 0.25 * Ts;                % Largura do pulso retangular (25% do período - Duty Cycle = 0.25)

%% 4. GERAÇÃO DO TREM DE PULSOS p(t) E SINAL AMOSTRADO s(t)
% Trem de pulsos retangulares rect((t - nTs)/d)
p_t = double(mod(t, Ts) < d);

% Amostragem Natural: multiplicação direta no tempo s(t) = g(t) * p(t)
s_t = g_t .* p_t;

%% 5. ANÁLISE ESPECTRAL NO DOMÍNIO DA FREQUÊNCIA (FFT)
f_eixo = (-N/2 : N/2 - 1) * (Fs_sim / N); % Eixo de frequências centrado em zero

% FFT dos sinais no tempo
G_f = fftshift(fft(g_t)) / N;
S_f = fftshift(fft(s_t)) / N;

%% 6. FILTRAGEM DE RECONSTRUÇÃO (FILTRO PASSA-BAIXA IDEAL)
% Filtro passa-baixa ideal corte em fc (ex: Fs_amostragem / 2)
fc = Fs_amostragem / 2;

% Resposta em frequência do filtro ideal no domínio discreto
H_f = zeros(1, N);
H_f(abs(f_eixo) <= fc) = 1.0;

% Ganho de compensação do nível DC do trem de pulsos (1 / c0 = Ts / d)
ganho_compensacao = Ts / d;

% Aplicação do filtro no domínio da frequência
G_rec_f = S_f .* H_f * ganho_compensacao;

% Reconstrução do sinal no tempo via IFFT
g_rec_t = real(ifft(fftshift(G_rec_f))) * N;

%% 7. VISUALIZAÇÃO DOS RESULTADOS

% --- FIGURA 1: DOMÍNIO DO TEMPO ---
figure('Name', 'Amostragem Natural - Domínio do Tempo', 'NumberTitle', 'off');

subplot(3,1,1);
plot(t, g_t, 'b', 'LineWidth', 1.2);
title('Sinal Analógico Original g(t) = A_1 cos(2\pi f_1 t) + A_2 cos(2\pi f_2 t)');
xlabel('Tempo (s)'); ylabel('Amplitude'); grid on; xlim([0 0.02]);

subplot(3,1,2);
plot(t, s_t, 'r', 'LineWidth', 1.2); hold on;
plot(t, p_t * max(g_t), 'k--', 'LineWidth', 0.8);
title(sprintf('Sinal Amostrado Naturalmente s(t) [f_s = %d Hz, d = %.2f ms]', Fs_amostragem, d*1e3));
xlabel('Tempo (s)'); ylabel('Amplitude'); grid on; xlim([0 0.02]);
legend('s(t) Amostrado', 'Trem de Pulsos p(t)');

subplot(3,1,3);
plot(t, g_t, 'b--', 'LineWidth', 1.0); hold on;
plot(t, g_rec_t, 'm', 'LineWidth', 1.2);
title('Sinal Reconstruído g_{rec}(t) após Filtro Passa-Baixa Ideal');
xlabel('Tempo (s)'); ylabel('Amplitude'); grid on; xlim([0 0.02]);
legend('Original g(t)', 'Reconstruído g_{rec}(t)');

% --- FIGURA 2: DOMÍNIO DA FREQUÊNCIA ---
figure('Name', 'Espectro de Frequências (FFT)', 'NumberTitle', 'off');

subplot(3,1,1);
plot(f_eixo, abs(G_f), 'b', 'LineWidth', 1.2);
title('Espectro do Sinal Original |G(f)|');
xlabel('Frequência (Hz)'); ylabel('|G(f)|'); grid on; xlim([-3000 3000]);

subplot(3,1,2);
plot(f_eixo, abs(S_f), 'r', 'LineWidth', 1.2); hold on;
line([-fc -fc], [0 max(abs(S_f))], 'Color', 'g', 'LineStyle', '--', 'LineWidth', 1.5);
line([fc fc], [0 max(abs(S_f))], 'Color', 'g', 'LineStyle', '--', 'LineWidth', 1.5);
title(sprintf('Espectro Amostrado |S(f)| (Linhas verdes: Banda de Corte do Filtro f_c = %d Hz)', fc));
xlabel('Frequência (Hz)'); ylabel('|S(f)|'); grid on; xlim([-3000 3000]);

subplot(3,1,3);
plot(f_eixo, abs(G_rec_f), 'm', 'LineWidth', 1.2);
title('Espectro Reconstruído na Saída do Filtro |G_{rec}(f)|');
xlabel('Frequência (Hz)'); ylabel('|G_{rec}(f)|'); grid on; xlim([-3000 3000]);